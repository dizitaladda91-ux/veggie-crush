generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id        String    @id // = Supabase auth user id
  email     String    @unique
  name      String?
  phone     String?
  role      Role      @default(CUSTOMER)
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  wishlist  Wishlist[]
  createdAt DateTime  @default(now())
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?  // "Home" / "Work"
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  orders    Order[]
  createdAt DateTime @default(now())
}

model Category {
  name        String    @unique
  slug        String    @unique
  id          String    @id @default(cuid())
  image       String?
  products    Product[]
}

model Condition {          // Shop-by-health-condition
  id       String             @id @default(cuid())
  name     String             @unique // "Diabetes Care", "Weight Management"
  slug     String             @unique
  products ProductCondition[]
}

model Product {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  description  String?
  images       String[]
  startingAt   Int                @default(0) // min variant price (paise), used for sorting/"Starts at ₹X"
  isBestSeller Boolean            @default(false)
  isActive     Boolean            @default(true)
  categoryId   String
  category     Category           @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  conditions   ProductCondition[]
  reviews      Review[]
  wishlist     Wishlist[]
  orderItems   OrderItem[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  price     Int
  mrp       Int
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([productId, label])
}

model ProductCondition {
  productId   String
  conditionId String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  condition   Condition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@id([productId, conditionId])
}

model Order {
  id            String        @id @default(cuid())
  userId        String
  addressId     String?
  user          User          @relation(fields: [userId], references: [id])
  address       Address?      @relation(fields: [addressId], references: [id])
  items         OrderItem[]
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  total         Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  name      String
  quantity  Int
  unitPrice Int
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Wishlist {
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}
# =============================================================================
# VeggieCrush Environment Variables (MongoDB + JWT + Vercel Deployment)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE (MongoDB Atlas URI)
# -----------------------------------------------------------------------------
MONGO_URI="mongodb://127.0.0.1:27017/veggiecrush"
DATABASE_URL="mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/veggiecrush?retryWrites=true&w=majority"

# -----------------------------------------------------------------------------
# 2. JWT SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
JWT_SECRET="your_long_random_jwt_secret_key_here"

# -----------------------------------------------------------------------------
# 3. SUPABASE (Auth fallback)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# -----------------------------------------------------------------------------
# 4. CLOUDINARY (Server-side image uploads; never expose this value to the browser)
# -----------------------------------------------------------------------------
# Preferred:
CLOUDINARY_URL="cloudinary://your-api-key:your-api-secret@your-cloud-name"
# Alternatively, set all three individual values:
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# -----------------------------------------------------------------------------
# 5. RAZORPAY (Payments Gateway)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# -----------------------------------------------------------------------------
# 6. APPLICATION SETTINGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
